rules_version = '2';

// =============================================================
//  Règles de sécurité Firestore — RE-BOOST
//  À copier dans : Console Firebase > Firestore Database > Règles
// =============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Vrai compte client (email / mot de passe ou Google), pas une session anonyme
    function hasAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email is string;
    }

    // Un administrateur = un document admins/{son UID}, créé à la main dans la console
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Liste des administrateurs : personne ne peut la modifier depuis le site
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Commandes SasPay : écrites uniquement par le serveur de paiement
    // (compte de service), consultables par l'administrateur
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Licence active et appartenant bien à ce compte ?
    function ownsActiveLicense(key) {
      let lic = get(/databases/$(database)/documents/licenses/$(key)).data;
      return lic.activatedUid == request.auth.uid
        && lic.status == 'active'
        && (lic.expiresAt == null || lic.expiresAt > request.time);
    }

    // Client avec un accès actif (via sa fiche members/{UID})
    function isMember() {
      return hasAccount()
        && ownsActiveLicense(get(/databases/$(database)/documents/members/$(request.auth.uid)).data.licenseKey);
    }

    // Fiche membre : relie le compte à sa licence (créée par le site du client)
    match /members/{uid} {
      allow read: if isAdmin() || (hasAccount() && request.auth.uid == uid);
      allow create, update: if hasAccount()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['licenseKey', 'updatedAt'])
        && request.resource.data.licenseKey is string
        && request.resource.data.updatedAt == request.time
        && ownsActiveLicense(request.resource.data.licenseKey);
      allow delete: if isAdmin();
    }

    // Liens des formations (Telegram, Google Drive) : réservés aux clients actifs,
    // modifiables uniquement par l'administrateur
    match /training/{docId} {
      allow read: if isAdmin() || isMember();
      allow write: if isAdmin();
    }

    match /licenses/{key} {
      // L'administrateur peut tout faire
      allow read, write: if isAdmin();

      // Un client peut lire UNE licence s'il connaît sa clé (impossible de lister les clés)
      allow get: if hasAccount();

      // Un client peut retrouver la licence liée à son compte
      allow list: if hasAccount() && resource.data.activatedUid == request.auth.uid;

      // Un client peut activer une clé avec son compte : clé libre (ou déjà à lui),
      // et réservée à son email si l'administrateur l'a restreinte
      allow update: if hasAccount()
        && resource.data.status == 'active'
        && (resource.data.expiresAt == null || resource.data.expiresAt > request.time)
        && (resource.data.clientEmail == null
            || resource.data.clientEmail == request.auth.token.email.lower())
        && (resource.data.activated == false
            || resource.data.activatedUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['activated', 'activatedAt', 'activatedBy', 'activatedUid', 'userName'])
        && request.resource.data.activated == true
        && request.resource.data.activatedUid == request.auth.uid
        && request.resource.data.activatedAt == request.time
        && request.resource.data.activatedBy == request.auth.token.email
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 100;
    }
  }
}
